{
  "name": "@finplan/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "test": "bun scripts/run-tests.ts",
    "test:coverage": "bun scripts/run-tests.ts --coverage",
    "test:file": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src/ --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@finplan/shared": "*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-hotkeys-hook": "^4.6.2",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "size-limit": [
    {
      "name": "Entry JS (gzip)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "150 KB"
    },
    {
      "name": "Charts vendor chunk — recharts/d3 (gzip)",
      "path": "dist/assets/charts-*.js",
      "gzip": true,
      "limit": "118 KB"
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@happy-dom/global-registrator": "^20.14.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-shape": "^3.1.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jest-axe": "^10.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.30",
    "size-limit": "^12.1.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
